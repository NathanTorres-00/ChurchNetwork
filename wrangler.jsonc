{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production: therocknetwork.com. `npm run deploy` builds and deploys it; Workers Builds runs the same on
  // every push to main once the GitHub repo is connected in the Cloudflare dashboard.
  "name": "the-rock-network",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "routes": [
    { "pattern": "therocknetwork.com", "custom_domain": true },
    { "pattern": "www.therocknetwork.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // www requests reach the script first so it can redirect them
    "run_worker_first": true
  },
  "env": {
    // The preview Worker (rock-network-preview.tr-playground.workers.dev): `npm run deploy:preview`
    "preview": {
      "name": "rock-network-preview",
      "routes": []
    }
  }
}
