---
import { getEntry } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import VideosHero from "@/components/section/VideosHero.astro";
import VideoRow from "@/components/content/VideoRow.astro";
import VideoPlayer from "@/components/global/VideoPlayer.astro";
import { getVideos } from "@/utils/videos.ts";

// The videos and their order live in src/content/videos/ and src/content/pages/videos.json
const { heading, featured, series } = await getVideos();
const weekly = (await getEntry("weeklyVideo", "current"))?.data;
const heroVideos = weekly ? [{
  title: weekly.title,
  poster: `https://i.ytimg.com/vi/${weekly.youtubeId}/hqdefault.jpg`,
  src: `https://www.youtube-nocookie.com/embed/${weekly.youtubeId}?rel=0&playsinline=1`,
  series: "Weekly Network Video",
  label: weekly.title,
  weekly: true,
}, ...featured] : featured;
---

<Layout
  title={heading}
  description="Watch the weekly church group video, Jesus Disciple Vision Videos, how-to videos, and stories from The Rock Network."
  page="videos"
>
  <div class="videos-page_wrap">
    <VideosHero heading={heading} videos={heroVideos} />
    <div class="videos-page_rows">
      {series.map((group) => <VideoRow id={group.id} heading={group.heading} videos={group.videos} />)}
    </div>
  </div>
  <Fragment slot="after">
    <VideoPlayer />
  </Fragment>
</Layout>

<style is:global>
  @layer components {
    /* The whole page is the screening room, down to the footer */
    .videos-page_wrap {
      background: #04101c;
    }
    .videos-page_rows {
      padding-block: clamp(1rem, 3vw, 2rem) clamp(5rem, 10vw, 8rem);
    }
  }
</style>
