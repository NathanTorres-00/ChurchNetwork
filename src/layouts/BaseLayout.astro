---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import SiteHeader from "@/components/global/SiteHeader.astro";
import SiteFooter from "@/components/global/SiteFooter.astro";
import PageTransition from "@/components/utility/PageTransition.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** The page being shown. Sets the header's links and the footer's; `embed` shows neither. */
  page: "home" | "groups" | "leadership" | "embed" | "other";
};

const { page, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[page === "embed" && "embed-globe"]}>
  <head>
    <BaseHead {...seo} />
    <PageTransition render={page !== "embed"} />
    {page !== "embed" && <script is:inline src="/scripts/site-footer.js" />}
    <slot name="head" />
  </head>
  <body>
    <slot name="top" />
    <SkipLink render={page !== "embed"} />
    <SiteHeader page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter page={page} />
    <slot name="after" />
    <script is:inline>
      // Links marked data-placeholder have nowhere to go yet: they show, but don't navigate
      document.addEventListener("click", (e) => {
        if (e.target.closest && e.target.closest("a[data-placeholder]")) e.preventDefault();
      });
    </script>
  </body>
</html>
