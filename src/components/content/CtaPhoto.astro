---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";

type Link = { label: string; href: string; placeholder?: boolean };

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Heading beside the photo. */
  heading: string;
  /** Paragraph under the heading. */
  lead?: string;
  /** Tall photo on the left. */
  photo: ImageMetadata;
  /** Describes the photo for screen readers. */
  photoAlt?: string;
  /** Link under the text. */
  button?: Link;
}

const { render = true, heading, lead, photo, photoAlt = "", button, class: className, ...rest } = Astro.props;
---

{
  render && heading && (
    <div class:list={["cta-photo_wrap", className]} {...rest}>
      <div class="frame cta-photo_photo">
        <Image src={photo} alt={photoAlt} widths={[600, 1200]} sizes="(max-width: 860px) 100vw, 500px" loading="lazy" />
      </div>
      <div>
        <h2 class="cta-photo_title text-style-h2">{heading}</h2>
        {lead && <p class="cta-photo_lead text-style-large">{lead}</p>}
        {button && (
          <p class="cta-photo_action">
            <Button element="link" href={button.href} data-placeholder={button.placeholder ? "" : undefined}>
              {button.label}
            </Button>
          </p>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* A tall photo beside a heading, a line and a button */
    .cta-photo_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2rem, 6vw, 5.5rem);
      align-items: center;
      @media (max-width: 53.75em) {
        grid-template-columns: 1fr;
      }
    }
    .cta-photo_photo {
      aspect-ratio: 4 / 5;
      @media (max-width: 53.75em) {
        aspect-ratio: 4 / 3;
      }
      & img {
        object-position: 50% 40%;
      }
    }
    .cta-photo_lead {
      margin-top: 1.125rem;
      max-width: 52ch;
    }
    .cta-photo_action {
      margin-top: 2rem;
    }
  }
</style>
