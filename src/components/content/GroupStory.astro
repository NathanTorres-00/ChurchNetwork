---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Img from "@/components/media/Img.astro";

interface Props extends HTMLAttributes<"figure"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The words, with their quotation marks. */
  quote: string;
  /** Who said it, shown in bold before the attribution. */
  name?: string;
  /** Who they are, after the name. */
  attribution: string;
  /** Photo behind the quote. */
  photo?: ImageMetadata | string;
  /** Describes the photo for screen readers. */
  photoAlt?: string;
  /** `overlay`: the words over the photo (Groups). `side`: the photo beside the words (Home's testimony). */
  variant?: "overlay" | "side";
}

const {
  render = true,
  quote,
  name,
  attribution,
  photo,
  photoAlt = "",
  variant = "overlay",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && quote && variant === "overlay" && (
    <figure class:list={["frame group-story_wrap", className]} {...rest}>
      {typeof photo === "string" ? (
        <Img class="group-story_photo" src={photo} alt={photoAlt} />
      ) : photo && (
        <Image
          class="group-story_photo"
          src={photo}
          alt={photoAlt}
          widths={[800, 1600, photo.width]}
          sizes="(max-width: 1180px) 100vw, 1132px"
          loading="lazy"
        />
      )}
      <blockquote class="group-story_quote">
        <p class="group-story_text">{quote}</p>
        <footer class="group-story_by">
          <span class="glyph" aria-hidden="true" />
          <span>
            {name && <strong>{name}</strong>}
            {name ? `, ${attribution}` : attribution}
          </span>
        </footer>
      </blockquote>
    </figure>
  )
}
{
  render && quote && variant === "side" && (
    <div class:list={["group-story_wrap side", className]} {...rest}>
      {photo && (
        <div class="frame group-story_frame">
          {typeof photo === "string" ? (
            <Img class="group-story_photo" src={photo} alt={photoAlt} />
          ) : <Image
            class="group-story_photo"
            src={photo}
            alt={photoAlt}
            widths={[500, 1000, photo.width]}
            sizes="(max-width: 860px) 100vw, 450px"
            loading="lazy"
          />}
        </div>
      )}
      <blockquote class="group-story_quote">
        <p class="group-story_text">{quote}</p>
        <footer class="group-story_by">
          <span class="glyph" aria-hidden="true" />
          <span>
            {name && <strong>{name}</strong>}
            {name ? `, ${attribution}` : attribution}
          </span>
        </footer>
      </blockquote>
    </div>
  )
}

<style is:global>
  @layer components {
    /* A group member's words over their group's photo */
    .group-story_wrap {
      position: relative;
      isolation: isolate;
      width: 100%;
      min-height: 35rem;
      display: grid;
      place-items: center;
      padding: clamp(2.5rem, 7vw, 6rem);
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: rgb(20 20 24 / 0.55);
      }
    }
    .group-story_photo {
      position: absolute;
      inset: 0;
      z-index: -2;
      object-position: 50% 35%;
    }
    .group-story_quote {
      margin: 0;
      max-width: 51.25rem;
      text-align: center;
      color: #fff;
    }
    .group-story_text {
      margin: 0;
      font-size: clamp(1.625rem, 3.2vw, 2.625rem);
      line-height: 1.25;
      letter-spacing: -0.02em;
      font-weight: var(--primary-medium);
      text-wrap: balance;
    }
    /* Side: the photo beside the words, the words in the page's ink */
    .group-story_wrap.side {
      min-height: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(2rem, 6vw, 5.5rem);
      align-items: center;
      place-items: initial;
      align-items: center;
      &::after {
        display: none;
      }
      & .group-story_frame {
        aspect-ratio: 4 / 4.6;
      }
      & .group-story_photo {
        position: static;
        object-position: 50% 30%;
      }
      & .group-story_quote {
        max-width: none;
        text-align: start;
        color: var(--heading);
      }
      & .group-story_text {
        font-weight: var(--primary-regular);
        font-size: clamp(1.625rem, 2.8vw, 2.375rem);
        line-height: 1.3;
        letter-spacing: -0.02em;
        text-indent: -0.42em;
        text-wrap: wrap;
      }
      & .group-story_by {
        display: flex;
        color: var(--text);
        & .glyph {
          --ring: #fff;
        }
        & strong {
          color: var(--heading);
          font-weight: var(--primary-medium);
        }
      }
      @media (max-width: 53.75em) {
        grid-template-columns: 1fr;
        & .group-story_frame {
          aspect-ratio: 4 / 3;
        }
      }
    }
    .group-story_by {
      margin-top: 1.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1rem;
      color: rgb(255 255 255 / 0.88);
      & .glyph {
        --ring: #2b2b30;
      }
    }
  }
</style>
