---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";

type CardButton = { label: string; href: string; placeholder?: boolean };

interface Props extends HTMLAttributes<"article"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Card title. */
  heading: string;
  /** Line above the list. */
  intro?: string;
  /** What marks this kind of group, one line each. */
  traits?: string[];
  /** Link at the foot of the card. */
  button?: CardButton;
  /** Which of the four headline colors marks the card. */
  color?: "disciples" | "leaders" | "churches" | "movements";
}

const {
  render = true,
  heading,
  intro,
  traits = [],
  button,
  color = "disciples",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && heading && (
    <article
      class:list={["group-card_wrap", className]}
      style={`--gc: var(--c-${color})`}
      {...rest}
    >
      <svg class="group-card_trace" aria-hidden="true" focusable="false">
        <path />
      </svg>
      <p class="group-card_tag" aria-hidden="true">
        <span class="glyph" />
      </p>
      <h3 class="group-card_title">{heading}</h3>
      {intro && <p class="group-card_intro">{intro}</p>}
      {traits.length > 0 && (
        <ul class="group-card_list">
          {traits.map((trait) => (
            <li class="group-card_item">{trait}</li>
          ))}
        </ul>
      )}
      {button && (
        <Button element="link" href={button.href} data-placeholder={button.placeholder ? "" : undefined}>
          {button.label}
        </Button>
      )}
    </article>
  )
}

<script>
  for (const svg of document.querySelectorAll<SVGSVGElement>(".group-card_trace")) {
    const card = svg.parentElement;
    const path = svg.querySelector("path");
    if (!card || !path) continue;
    let length = 0;
    let entry = 0;
    let hovering = false;
    let traced = false;

    const draw = (halfLength: number, animate: boolean) => {
      path.style.transition = animate ? "" : "none";
      path.style.strokeDasharray = `${2 * halfLength} ${length - 2 * halfLength}`;
      path.style.strokeDashoffset = `${halfLength - entry * length}`;
    };

    const resize = () => {
      const { width, height } = card.getBoundingClientRect();
      if (!width || !height) return;
      const inset = parseFloat(getComputedStyle(path).strokeWidth) / 2;
      const radius = Math.min(parseFloat(getComputedStyle(card).borderTopLeftRadius), width / 2, height / 2);
      const corner = Math.max(0, radius - inset);
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      path.setAttribute(
        "d",
        [
          `M${radius} ${inset} H${width - radius}`,
          `A${corner} ${corner} 0 0 1 ${width - inset} ${radius} V${height - radius}`,
          `A${corner} ${corner} 0 0 1 ${width - radius} ${height - inset} H${radius}`,
          `A${corner} ${corner} 0 0 1 ${inset} ${height - radius} V${radius}`,
          `A${corner} ${corner} 0 0 1 ${radius} ${inset} Z`,
        ].join(" "),
      );
      length = path.getTotalLength();
      draw(traced ? length / 2 : 0, false);
    };

    const start = (position: number) => {
      entry = position;
      draw(0, false);
      path.getBoundingClientRect();
      traced = true;
      draw(length / 2, true);
    };

    const stop = () => {
      traced = false;
      draw(0, true);
    };

    card.addEventListener("pointerenter", (event) => {
      hovering = true;
      const { left, top } = card.getBoundingClientRect();
      const x = event.clientX - left;
      const y = event.clientY - top;
      let nearest = 0;
      let nearestDistance = Infinity;
      for (let step = 0; step < 180; step++) {
        const position = step / 180;
        const point = path.getPointAtLength(length * position);
        const distance = (point.x - x) ** 2 + (point.y - y) ** 2;
        if (distance < nearestDistance) {
          nearest = position;
          nearestDistance = distance;
        }
      }
      start(nearest);
    });
    card.addEventListener("pointerleave", () => {
      hovering = false;
      if (!card.contains(document.activeElement)) stop();
    });
    card.addEventListener("focusin", () => {
      if (!traced) start(0);
    });
    card.addEventListener("focusout", (event) => {
      if (!hovering && !card.contains(event.relatedTarget as Node | null)) stop();
    });

    resize();
    new ResizeObserver(resize).observe(card);
  }
</script>

<style is:global>
  @layer components {
    .group-card_wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: clamp(2rem, 4vw, 3rem);
      border-radius: var(--radius-main);
      background: var(--background-2);
    }
    /* ---------- Trace: a single dash grows both ways from where the pointer came in ---------- */
    .group-card_trace {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      & path {
        fill: none;
        stroke: var(--gc);
        stroke-width: 0.109375rem;
        stroke-linecap: butt;
        transition:
          stroke-dasharray 0.9s cubic-bezier(0.65, 0, 0.35, 1),
          stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1);
        @media (prefers-reduced-motion: reduce) {
          transition: none;
        }
      }
    }
    .group-card_tag {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin: 0 0 1.375rem;
      font-size: 0.9375rem;
      font-weight: var(--primary-medium);
      color: var(--gc);
      & .glyph {
        --g: 0.75rem;
        --ring: var(--background-2);
        margin: 0 0.25rem 0 0.4375rem;
      }
    }
    .group-card_intro {
      margin: 1.75rem 0 0.625rem;
      color: var(--heading);
      font-weight: var(--primary-medium);
    }
    .group-card_list {
      margin: 0 0 2.25rem;
      display: grid;
      flex: 1;
      align-content: start;
      width: 100%;
    }
    .group-card_item {
      display: flex;
      gap: 0.875rem;
      align-items: baseline;
      padding: 0.75rem 0;
      border-top: var(--border-width) solid var(--border);
      &:last-child {
        border-bottom: var(--border-width) solid var(--border);
      }
      &::before {
        content: "";
        flex: none;
        width: 0.4375rem;
        height: 0.4375rem;
        border-radius: 50%;
        background: var(--gc);
        translate: 0 -0.125rem;
      }
    }
  }
</style>
