---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props extends Omit<HTMLAttributes<"li">, "role"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Full name. */
  name: string;
  /** Role in the network, under the name. */
  role?: string;
  /** Portrait, shown as a ring-dot. Without one, a placeholder glyph shows in its place. */
  photo?: ImageMetadata;
}

const { render = true, name, role, photo, class: className, ...rest } = Astro.props;
---

{
  render && name && (
    <li class:list={["team-member_wrap", className]} {...rest}>
      {photo ? (
        <Image class="team-member_photo" src={photo} alt="" widths={[180, 360]} sizes="180px" loading="lazy" />
      ) : (
        <span class="team-member_photo is-empty">
          <span class="glyph" aria-hidden="true" />
        </span>
      )}
      <h3 class="team-member_name">{name}</h3>
      {role && <p class="team-member_role">{role}</p>}
    </li>
  )
}

<style is:global>
  @layer components {
    /* A leader as a ring-dot: their photo in a circle with a green ring, their name under it */
    .team-member_wrap {
      display: grid;
      justify-items: center;
      gap: 1.125rem;
      text-align: center;
    }
    .team-member_photo {
      width: min(100%, 11.25rem);
      height: auto;
      aspect-ratio: 1;
      border-radius: 50%;
      object-fit: cover;
      background: #e9e9ec;
      box-shadow:
        0 0 0 0.25rem var(--background-2),
        0 0 0 0.40625rem var(--c-disciples);
      &.is-empty {
        display: grid;
        place-items: center;
        & .glyph {
          --g: 1.125rem;
          --gc: #c9c9cf;
          --ring: #e9e9ec;
        }
      }
    }
    .team-member_name {
      margin: 0;
      font-size: 1.125rem;
      font-weight: var(--primary-medium);
      line-height: 1.3;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }
    .team-member_role {
      margin: -0.75rem 0 0;
      font-size: 0.9375rem;
    }
  }
</style>
