---
import type { HTMLAttributes } from "astro/types";

type Step = { when: string; heading: string; body: string };

interface Props extends HTMLAttributes<"ol"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Milestones in order; each takes the next headline color and a bigger dot. */
  items: Step[];
}

const { render = true, items, class: className, ...rest } = Astro.props;
---

{
  render && items.length > 0 && (
    <ol class:list={["timeline_list", className]} {...rest}>
      {items.map((item) => (
        <li class="timeline_step">
          <div class="timeline_node">
            <span class="glyph" aria-hidden="true" />
          </div>
          <p class="timeline_when">{item.when}</p>
          <h3 class="timeline_title">{item.heading}</h3>
          <p class="timeline_text">{item.body}</p>
        </li>
      ))}
    </ol>
  )
}

<style is:global>
  @layer components {
    /* How we got started: milestones on a thread, across on wide screens and down on narrow ones */
    .timeline_list {
      width: 100%;
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
      &::before {
        content: "";
        position: absolute;
        top: 1.375rem;
        left: 1.375rem;
        right: 0;
        height: var(--border-width);
        background: #d4d4d8;
      }
      @media (max-width: 53.75em) {
        grid-template-columns: 1fr;
        gap: 2.25rem;
        &::before {
          top: 1.375rem;
          bottom: 1.375rem;
          left: 1.3125rem;
          right: auto;
          width: var(--border-width);
          height: auto;
        }
      }
    }
    .timeline_step {
      position: relative;
      &:nth-child(4n + 1) {
        --size: 0.5625rem;
        --color: var(--c-disciples);
      }
      &:nth-child(4n + 2) {
        --size: 0.75rem;
        --color: var(--c-leaders);
      }
      &:nth-child(4n + 3) {
        --size: 0.9375rem;
        --color: var(--c-churches);
      }
      &:nth-child(4n + 4) {
        --size: 1.1875rem;
        --color: var(--c-movements);
      }
      @media (max-width: 53.75em) {
        padding-left: 4rem;
      }
    }
    .timeline_node {
      height: 2.75rem;
      display: flex;
      align-items: center;
      & .glyph {
        --g: var(--size);
        --gc: var(--color);
        box-shadow:
          0 0 0 calc(var(--g) * 0.3) var(--background-2),
          0 0 0 calc(var(--g) * 0.56) var(--gc);
      }
      @media (max-width: 53.75em) {
        position: absolute;
        left: 0;
        top: 0;
        width: 2.75rem;
        justify-content: center;
      }
    }
    .timeline_when {
      margin: 1.375rem 0 0.375rem;
      font-size: 0.875rem;
      font-weight: var(--primary-medium);
      color: var(--color);
      @media (max-width: 53.75em) {
        margin-top: 0.625rem;
      }
    }
    .timeline_title {
      margin: 0;
      font-size: 1.3125rem;
      line-height: 1.25;
      font-weight: var(--primary-medium);
      letter-spacing: -0.01em;
    }
    .timeline_text {
      margin: 0.625rem 0 0;
    }
  }
</style>
