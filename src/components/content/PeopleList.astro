---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Person = { id: string; name: string; photo?: ImageMetadata; anchor: boolean };

interface Props extends HTMLAttributes<"ul"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** People in order. `anchor` gives the person the place the orbit links to (once per page). */
  people: Person[];
  /** `network`: larger ring-dots in green. `group`: smaller ring-dots in gold. */
  variant?: "network" | "group";
}

const { render = true, people, variant = "network", class: className, ...rest } = Astro.props;
---

{
  render && people.length > 0 && (
    <ul class:list={["people", `people-${variant}`, className]} {...rest}>
      {/* public/scripts/leadership-orbit.js reads .person, its id, .person-name and img */}
      {people.map((person) => (
        <li class={`person is-${variant}`} id={person.anchor ? `p-${person.id}` : undefined}>
          {person.photo ? (
            <Image src={person.photo} alt="" widths={[180, 360]} sizes="180px" loading="lazy" />
          ) : (
            <span class="person-empty" aria-hidden="true" />
          )}
          <span class="person-name">{person.name}</span>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    /* Network leaders and group leaders: every person a ring-dot, green for the network, gold for its groups */
    .people {
      --c-network: var(--c-disciples);
      --c-group: var(--c-leaders);
      width: 100%;
      margin-top: -0.5rem;
      display: grid;
      gap: 3rem 2rem;
      @media (max-width: 40em) {
        gap: 2.25rem 1rem;
      }
    }
    .people-network {
      grid-template-columns: repeat(auto-fill, minmax(11.875rem, 1fr));
      @media (max-width: 40em) {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .people-group {
      grid-template-columns: repeat(auto-fill, minmax(8.75rem, 1fr));
      gap: 2.5rem 1.5rem;
      @media (max-width: 40em) {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.75rem 0.75rem;
      }
    }
    .person {
      display: grid;
      justify-items: center;
      gap: 1.125rem;
      text-align: center;
      scroll-margin-top: 7.5rem;
      &.is-network {
        --ring: var(--c-network);
      }
      &.is-group {
        --ring: var(--c-group);
      }
      & img,
      & .person-empty {
        width: min(100%, 11.25rem);
        height: auto;
        aspect-ratio: 1;
        border-radius: 50%;
        object-fit: cover;
        background: #e9e9ec;
        --gap: 0.25rem;
        --ring-w: 0.15625rem;
        box-shadow:
          0 0 0 var(--gap) #fff,
          0 0 0 calc(var(--gap) + var(--ring-w)) var(--ring);
      }
      /* arriving from the orbit, the person's ring pulses once so you can find them */
      &:target img {
        animation: found 1.4s ease-out 1;
      }
    }
    .people-group .person :is(img, .person-empty) {
      width: min(100%, 8.25rem);
      --gap: 0.1875rem;
      --ring-w: 0.125rem;
    }
    .person-name {
      color: var(--heading);
      font-size: 1.125rem;
      font-weight: var(--primary-medium);
      line-height: 1.3;
      letter-spacing: -0.01em;
      text-wrap: balance;
      @media (max-width: 40em) {
        font-size: 1rem;
      }
    }
    .people-group .person-name {
      font-size: 1rem;
      @media (max-width: 40em) {
        font-size: 0.875rem;
      }
    }
    @keyframes found {
      0%,
      100% {
        scale: 1;
      }
      30% {
        scale: 1.06;
      }
    }
  }
</style>
