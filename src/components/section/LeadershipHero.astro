---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Page title. */
  heading: string;
  /** Line under the title. */
  lead?: string;
  /** Links to the page's own sections, under the lead. */
  directory?: { label: string; href: string }[];
  /** Label under the orbit. */
  key: string;
}

const { render = true, heading, lead, directory = [], key, class: className, ...rest } = Astro.props;
---

{
  render && heading && (
    <section class:list={["lead-hero", className]} {...rest}>
      <canvas class="lead-hero_field" aria-hidden="true" />
      <div class="lead-hero_layout">
        <h1 class="lead-hero_title">{heading}</h1>
        {lead && <p class="lead-hero_lead">{lead}</p>}
        {directory.length > 0 && (
          <nav class="lead-hero_directory" aria-label="On this page">
            {directory.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        )}
        {/* public/scripts/leadership-orbit.js adds one ring-dot per person here, read from the lists below */}
        <div class="orbit" id="orbit">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="45" pathLength="1" />
          </svg>
          <span class="orbit-center">
            <span class="logo" role="img" aria-label="The Rock Network" />
          </span>
        </div>
        <ul class="orbit-key">
          <li class="is-group">{key}</li>
        </ul>
      </div>
    </section>
  )
}

<script>
  // The hero's dots ripple around the pointer and settle when it leaves
  const hero = document.querySelector<HTMLElement>(".lead-hero");
  const canvas = hero?.querySelector<HTMLCanvasElement>(".lead-hero_field");
  const context = canvas?.getContext("2d");
  if (hero && canvas && context) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const spacing = 22;
    const strength = 0.6;
    const color = getComputedStyle(hero).getPropertyValue("--lead-hero-dot").trim();
    const origin = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let visible = false;
    let frame = 0;
    let energy = 0;
    let targetEnergy = 0;

    const draw = (now: number) => {
      const time = now / 1000;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      context.clearRect(0, 0, width, height);
      context.fillStyle = color;
      for (let y = spacing / 2; y < height; y += spacing) {
        for (let x = spacing / 2; x < width; x += spacing) {
          const distance = Math.hypot(x - origin.x, y - origin.y);
          const proximity = Math.exp(-((distance / 320) ** 2));
          const wave = 0.5 + 0.5 * Math.sin(distance / 46 - time * 1.7);
          const amplitude = strength * energy * proximity * wave;
          context.globalAlpha = 0.4 + 0.6 * amplitude;
          context.beginPath();
          context.arc(x, y, 1 + 2.8 * amplitude, 0, Math.PI * 2);
          context.fill();
        }
      }
      context.globalAlpha = 1;
    };
    const wake = () => {
      if (!frame && visible && !motion.matches && (targetEnergy || energy > 0.005)) frame = requestAnimationFrame(animate);
    };
    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };
    const animate = (now: number) => {
      frame = 0;
      origin.x += (target.x - origin.x) * 0.08;
      origin.y += (target.y - origin.y) * 0.08;
      energy += (targetEnergy - energy) * 0.04;
      if (!targetEnergy && energy <= 0.005) energy = 0;
      draw(now);
      wake();
    };

    new ResizeObserver(() => {
      const bounds = hero.getBoundingClientRect();
      width = bounds.width;
      height = bounds.height;
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      if (!targetEnergy) {
        origin.x = target.x = width * 0.75;
        origin.y = target.y = height * 0.5;
      }
      draw(performance.now());
    }).observe(hero);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) wake();
      else stop();
    }).observe(hero);
    hero.addEventListener("pointermove", (event) => {
      const bounds = hero.getBoundingClientRect();
      target.x = event.clientX - bounds.left;
      target.y = event.clientY - bounds.top;
      targetEnergy = 1;
      wake();
    });
    hero.addEventListener("pointerleave", () => {
      targetEnergy = 0;
      wake();
    });
    motion.addEventListener("change", () => {
      if (motion.matches) {
        stop();
        energy = 0;
        draw(performance.now());
      } else wake();
    });
  }
</script>

<style is:global>
  @layer components {
    /* The Groups leaders and overseers on one orbit around The Rock Network, over a field of dots that ripple near
       the pointer. .orbit, .node, .is-group and .orbit-center keep their old names:
       the orbit script builds the nodes. */
    .lead-hero {
      --c-network: var(--c-disciples);
      --c-group: var(--c-leaders);
      --lead-hero-dot: #c9c9cd;
      position: relative;
      isolation: isolate;
      background: var(--background-2);
      padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(4.5rem, 9vw, 7.5rem);
      padding-top: calc(var(--nav-height) + clamp(3rem, 7vw, 5.5rem));
      /* a name tag on the ring can reach past the window's edge; it must not make the page scroll sideways */
      overflow-x: clip;
    }
    .lead-hero_field {
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .lead-hero_directory {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem 1.5rem;
      margin-top: 1.5rem;
      & a {
        color: var(--heading);
        font-size: 0.9375rem;
        text-underline-offset: 0.25rem;
        &:hover {
          color: var(--c-network);
        }
      }
    }
    .lead-hero_layout {
      width: var(--site-width);
      max-width: var(--max-width-main);
      margin-inline: auto;
    }
    .lead-hero_title {
      margin: 0;
      font-weight: var(--primary-bold);
      letter-spacing: -0.04em;
      line-height: 1;
      font-size: clamp(3.25rem, 8vw, 7rem);
    }
    .lead-hero_lead {
      margin-top: 1.25rem;
      max-width: 52ch;
      font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
      line-height: 1.4;
      letter-spacing: -0.01em;
    }

    /* The orbits: a square whose people sit on two circles. --node is each ring-dot's diameter. */
    .orbit {
      position: relative;
      width: min(100%, 48.75rem);
      aspect-ratio: 1;
      margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
      container-type: inline-size;
      & svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      & circle {
        fill: none;
        stroke: #d9d9de;
        stroke-width: 0.14;
      }
    }
    .orbit-center {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 30%;
      translate: -50% -50%;
      display: grid;
      justify-items: center;
      gap: 0.625rem;
      color: var(--heading);
      text-decoration: none;
      & .logo {
        --logo-h: auto;
        width: 100%;
        height: auto;
      }
    }
    .node {
      --node: 11.8cqi;
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--node);
      height: var(--node);
      margin: calc(var(--node) / -2) 0 0 calc(var(--node) / -2);
      border-radius: 50%;
      text-decoration: none;
      color: var(--heading);
      z-index: 1;
      & :is(img, .node-empty) {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background: #e9e9ec;
        box-shadow:
          0 0 0 var(--gap, 0.1875rem) #fff,
          0 0 0 calc(var(--gap, 0.1875rem) + var(--ring-w, 0.125rem)) var(--ring);
      }
      &.is-group {
        --node: 8.2cqi;
        --gap: 0.125rem;
        --ring-w: 0.09375rem;
      }
      &:hover,
      &:focus-visible {
        z-index: 3;
      }
      &:hover .node-name,
      &:focus-visible .node-name {
        opacity: 1;
        transform: none;
      }
      &:focus-visible {
        outline: 0.125rem solid var(--heading);
        outline-offset: 0.375rem;
      }
    }
    .lead-hero .is-network {
      --ring: var(--c-network);
    }
    .lead-hero .is-group {
      --ring: var(--c-group);
    }
    /* the name shows under a ring-dot on hover or focus */
    .node-name {
      position: absolute;
      left: 50%;
      top: calc(100% + 0.625rem);
      translate: var(--name-offset, -50%) 0;
      white-space: nowrap;
      pointer-events: none;
      padding: 0.375rem 0.75rem;
      border-radius: var(--radius-round);
      background: var(--heading);
      color: #fff;
      font-size: 0.875rem;
      line-height: 1.2;
      opacity: 0;
      transform: translateY(-0.25rem);
      transition:
        opacity 0.18s ease,
        transform 0.18s ease;
      @media (max-width: 40em) {
        font-size: 0.8125rem;
      }
    }
    .orbit-key {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.75rem;
      margin: 1.75rem 0 0;
      font-size: 0.9375rem;
      & li {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        &::before {
          content: "";
          width: 0.5625rem;
          height: 0.5625rem;
          border-radius: 50%;
          background: var(--ring);
          margin: 0.3125rem;
          box-shadow:
            0 0 0 0.16875rem #fff,
            0 0 0 0.3125rem var(--ring);
        }
      }
    }

    /* On load the orbit draws and the leaders grow out from the center */
    @media (prefers-reduced-motion: no-preference) {
      .orbit:not(.is-growing) :is(.node, .orbit-center, circle) {
        opacity: 0;
      }
      .orbit.is-growing {
        & circle {
          stroke-dasharray: 1 1;
          stroke-dashoffset: 1;
          animation: orbit-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) forwards;
        }
        & .orbit-center {
          animation: node-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        & .node {
          animation: node-out 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
          animation-delay: calc(0.25s + var(--i) * 45ms);
        }
      }
    }
    @keyframes orbit-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes node-in {
      from {
        opacity: 0;
        scale: 0.9;
      }
    }
    @keyframes node-out {
      from {
        opacity: 0;
        transform: translate(var(--fx), var(--fy)) scale(0.2);
      }
    }
  }
</style>
