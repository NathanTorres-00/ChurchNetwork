---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Page title. */
  heading: string;
  /** Line under the title. */
  lead?: string;
  /** Labels of the two rings, under the orbit. */
  key: { network: string; group: string };
}

const { render = true, heading, lead, key, class: className, ...rest } = Astro.props;
---

{
  render && heading && (
    <section class:list={["lead-hero", className]} {...rest}>
      <div class="lead-hero_layout">
        <h1 class="lead-hero_title">{heading}</h1>
        {lead && <p class="lead-hero_lead">{lead}</p>}
        {/* public/scripts/leadership-orbit.js adds one ring-dot per person here, read from the lists below */}
        <div class="orbit" id="orbit">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="27" pathLength="1" />
            <circle cx="50" cy="50" r="45" pathLength="1" />
          </svg>
          <span class="orbit-center">
            <span class="logo" role="img" aria-label="The Rock Network" />
          </span>
        </div>
        <ul class="orbit-key">
          <li class="is-network">{key.network}</li>
          <li class="is-group">{key.group}</li>
        </ul>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    /* The network, with its leaders on two orbits around The Rock Network: network leaders inside (green rings),
       group leaders outside (gold). .orbit, .node, .is-network, .is-group and .orbit-center keep their old names:
       the orbit script builds the nodes. */
    .lead-hero {
      --c-network: var(--c-disciples);
      --c-group: var(--c-leaders);
      padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(4.5rem, 9vw, 7.5rem);
      padding-top: calc(var(--nav-height) + clamp(3rem, 7vw, 5.5rem));
      /* a name tag on the outer ring can reach past the window's edge; it must not make the page scroll sideways */
      overflow-x: clip;
    }
    .lead-hero_layout {
      width: var(--site-width);
      max-width: var(--max-width-main);
      margin-inline: auto;
    }
    .lead-hero_title {
      margin: 0;
      font-weight: var(--primary-bold);
      letter-spacing: -0.04em;
      line-height: 1;
      font-size: clamp(3.25rem, 8vw, 7rem);
    }
    .lead-hero_lead {
      margin-top: 1.25rem;
      max-width: 52ch;
      font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
      line-height: 1.4;
      letter-spacing: -0.01em;
    }

    /* The orbits: a square whose people sit on two circles. --node is each ring-dot's diameter. */
    .orbit {
      --inner: 27%;
      --outer: 45%;
      position: relative;
      width: min(100%, 48.75rem);
      aspect-ratio: 1;
      margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
      container-type: inline-size;
      & svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      & circle {
        fill: none;
        stroke: #d9d9de;
        stroke-width: 0.14;
      }
    }
    .orbit-center {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 30%;
      translate: -50% -50%;
      display: grid;
      justify-items: center;
      gap: 0.625rem;
      color: var(--heading);
      text-decoration: none;
      & .logo {
        --logo-h: auto;
        width: 100%;
        height: auto;
      }
    }
    .node {
      --node: 11.8cqi;
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--node);
      height: var(--node);
      margin: calc(var(--node) / -2) 0 0 calc(var(--node) / -2);
      border-radius: 50%;
      text-decoration: none;
      color: var(--heading);
      z-index: 1;
      & :is(img, .node-empty) {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background: #e9e9ec;
        box-shadow:
          0 0 0 var(--gap, 0.1875rem) #fff,
          0 0 0 calc(var(--gap, 0.1875rem) + var(--ring-w, 0.125rem)) var(--ring);
      }
      &.is-group {
        --node: 8.2cqi;
        --gap: 0.125rem;
        --ring-w: 0.09375rem;
      }
      &:hover,
      &:focus-visible {
        z-index: 3;
      }
      &:hover .node-name,
      &:focus-visible .node-name {
        opacity: 1;
        transform: none;
      }
      &:focus-visible {
        outline: 0.125rem solid var(--heading);
        outline-offset: 0.375rem;
      }
    }
    .lead-hero .is-network {
      --ring: var(--c-network);
    }
    .lead-hero .is-group {
      --ring: var(--c-group);
    }
    /* the name shows under a ring-dot on hover or focus */
    .node-name {
      position: absolute;
      left: 50%;
      top: calc(100% + 0.625rem);
      translate: -50% 0;
      white-space: nowrap;
      pointer-events: none;
      padding: 0.375rem 0.75rem;
      border-radius: var(--radius-round);
      background: var(--heading);
      color: #fff;
      font-size: 0.875rem;
      line-height: 1.2;
      opacity: 0;
      transform: translateY(-0.25rem);
      transition:
        opacity 0.18s ease,
        transform 0.18s ease;
      @media (max-width: 40em) {
        font-size: 0.8125rem;
      }
    }
    .orbit-key {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.75rem;
      margin: 1.75rem 0 0;
      font-size: 0.9375rem;
      & li {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        &::before {
          content: "";
          width: 0.5625rem;
          height: 0.5625rem;
          border-radius: 50%;
          background: var(--ring);
          margin: 0.3125rem;
          box-shadow:
            0 0 0 0.16875rem #fff,
            0 0 0 0.3125rem var(--ring);
        }
      }
    }

    /* The one moment of motion: on load the orbits draw and the leaders grow out from the center, the network's
       leaders first, then its group leaders, as the site's networks multiply */
    @media (prefers-reduced-motion: no-preference) {
      .orbit:not(.is-growing) :is(.node, .orbit-center, circle) {
        opacity: 0;
      }
      .orbit.is-growing {
        & circle {
          stroke-dasharray: 1 1;
          stroke-dashoffset: 1;
          animation: orbit-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) forwards;
        }
        & circle + circle {
          animation-delay: 0.35s;
        }
        & .orbit-center {
          animation: node-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        & .node {
          animation: node-out 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
          animation-delay: calc(0.25s + var(--i) * 45ms);
        }
      }
    }
    @keyframes orbit-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes node-in {
      from {
        opacity: 0;
        scale: 0.9;
      }
    }
    @keyframes node-out {
      from {
        opacity: 0;
        transform: translate(var(--fx), var(--fy)) scale(0.2);
      }
    }
  }
</style>
