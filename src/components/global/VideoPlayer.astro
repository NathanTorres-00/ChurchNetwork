---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{/* Plays links marked data-vimeo or data-youtube in this dialog. */}
{
  render && (
  <dialog class="video-player_wrap" aria-label="Video" closedby="any" data-lenis-prevent>
    <form method="dialog">
      <button class="video-player_close" type="submit" aria-label="Close video" autofocus>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </form>
    <div class="video-player_screen">
      <template>
        <iframe
          title="Video"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </template>
    </div>
  </dialog>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".video-player_wrap");
  const template = dialog?.querySelector("template");
  const screen = template?.parentElement;
  const frame = template?.content.querySelector("iframe");
  if (dialog && screen && frame) {
    let trigger: HTMLAnchorElement | undefined;
    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = event.target;
      const link = target instanceof Element && target.closest<HTMLAnchorElement>("a[data-vimeo], a[data-youtube]");
      if (!link || dialog.open) return;
      const player = frame.cloneNode() as HTMLIFrameElement;
      const title = link.dataset.videoTitle ?? link.getAttribute("aria-label") ?? link.textContent?.trim() ?? "Video";
      const url = new URL(link.href);
      url.searchParams.set("autoplay", "1");
      const previewTime = Number(link.dataset.previewTime);
      if (link.hasAttribute("data-vimeo") && Number.isFinite(previewTime) && previewTime > 0) {
        url.hash = `t=${previewTime}s`;
      }
      player.title = title;
      player.src = url.href;
      dialog.setAttribute("aria-label", title);
      dialog.showModal();
      event.preventDefault();
      trigger = link;
      screen.querySelector("iframe")?.remove();
      screen.append(player);
    });
    dialog.addEventListener("close", () => {
      if (dialog.open) return;
      screen.querySelector("iframe")?.remove();
      trigger?.focus({ preventScroll: true });
      trigger = undefined;
    });
  }
</script>

<style is:global>
  @layer components {
    html:has(.video-player_wrap[open]) {
      overflow: hidden;
    }
    /* The player is just the video: a 16:9 box it fills edge to edge, with a small round close button outside its
       top-right corner (Vimeo keeps its own buttons in the video's top-right corner) */
    .video-player_wrap {
      --player-close: 2.5rem;
      width: min(
        60rem,
        calc(100% - 2 * var(--site-margin)),
        max(15rem, calc((100dvh - 2 * var(--player-close) - 3rem) * 16 / 9))
      );
      max-width: none;
      max-height: none;
      margin: auto;
      padding: 0;
      overflow: visible;
      border: 0;
      background: transparent;
      color: #fff;
    }
    .video-player_wrap::backdrop {
      background: rgb(0 0 0 / 80%);
    }
    .video-player_wrap form {
      position: absolute;
      right: 0;
      bottom: 100%;
      padding-bottom: 0.625rem;
    }
    .video-player_close {
      display: grid;
      place-items: center;
      width: var(--player-close);
      height: var(--player-close);
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgb(255 255 255 / 92%);
      color: #1f1f23;
      cursor: pointer;
      transition: background 0.2s ease;
      &:hover {
        background: #fff;
      }
      &:focus-visible {
        outline: 0.125rem solid #fff;
        outline-offset: 0.1875rem;
      }
    }
    .video-player_screen {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: var(--radius-main);
      background: #000;
    }
    .video-player_screen iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  }
</style>
