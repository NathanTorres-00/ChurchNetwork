---
import type { HTMLAttributes } from "astro/types";
import { showLeadership } from "@/utils/leadership.ts";

interface Props extends HTMLAttributes<"header"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The page the header sits on. Home links to its own sections; other pages link back to them. */
  page: "home" | "groups" | "leadership" | "embed" | "other";
}

const { render = true, page, class: className, ...rest } = Astro.props;

const onHome = page === "home";
const home = onHome ? "" : "/";
const left = [
  { label: "Home", href: onHome ? "#top" : "/", current: onHome },
  { label: "What we do", href: `${home}#what-we-do` },
  { label: "How we do it", href: `${home}#how` },
  { label: "Our story", href: `${home}#story` },
];
const right = [
  { label: "Groups", href: "/groups", current: page === "groups" },
  { label: "Leadership", href: "/leadership", current: page === "leadership", render: showLeadership() },
  { label: "App", href: `${home}#app` },
].filter((link) => link.render !== false);
---

{
  render && page !== "embed" && (
    <header class:list={["site-header", className]} {...rest}>
      <div class="site-header_position">
        <nav class="site-nav is-top" aria-label="Site navigation">
          <button
            class="site-nav_brand"
            type="button"
            aria-label="The Rock Network menu"
            aria-expanded="false"
            aria-controls="site-nav-links"
          >
            <img src="/assets/the-rock-network.png" alt="" width="960" height="202" />
          </button>
          <div class="site-nav_links" id="site-nav-links" aria-hidden="true" inert>
            <div class="site-nav_side">
              {left.map((link) => (
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
            <div class="site-nav_side">
              {right.map((link) => (
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              ))}
              {onHome && (
                <a class="site-nav_cta" href="#hubs" hidden>
                  Find a hub
                </a>
              )}
            </div>
          </div>
        </nav>
      </div>
    </header>
  )
}

<script>
  // Option B (docs/superpowers/specs/2026-11-19-floating-nav-behavior-design.md): at the top of a wide screen the
  // bar is open; while reading it's a pill that hides on the way down and returns, closed, on the way up. Only
  // hover, a click or tap, or keyboard focus open the pill. Scrolling never does.
  const nav = document.querySelector<HTMLElement>(".site-nav");
  const brand = nav?.querySelector<HTMLButtonElement>(".site-nav_brand");
  const links = nav?.querySelector<HTMLElement>(".site-nav_links");
  if (nav && brand && links) {
    const scrollThreshold = 18;
    const readScroll = () => {
      const limit = document.documentElement.scrollHeight - window.innerHeight;
      return Math.max(0, Math.min(window.scrollY, limit));
    };
    // Within 5rem of the top counts as the top
    const atTop = (y: number) => y < 5 * parseFloat(getComputedStyle(document.documentElement).fontSize);
    // The pill's container query says whether the full bar fits (see --site-nav-mode below)
    const readWide = () => getComputedStyle(nav).getPropertyValue("--site-nav-mode").trim() !== "narrow";

    let previousY = readScroll();
    let distance = 0;
    let wide = readWide();
    let isTop = atTop(previousY);
    let hidden = false;
    let hovered = false;
    let pinned = false;
    // After closing it under the mouse (logo, Escape or a link), hover waits until the mouse leaves
    let hoverBlocked = false;

    const sync = () => {
      const asked = pinned || hovered || Boolean(links.querySelector(":focus-visible"));
      const open = asked || (isTop && wide);
      if (!open && links.contains(document.activeElement)) brand.focus({ preventScroll: true });
      nav.classList.toggle("is-top", isTop);
      nav.classList.toggle("is-open", asked);
      nav.classList.toggle("is-scroll-hidden", hidden);
      brand.setAttribute("aria-expanded", String(open));
      links.inert = !open;
      links.setAttribute("aria-hidden", String(!open));
    };

    const close = () => {
      pinned = hovered = false;
      if (nav.matches(":hover")) hoverBlocked = true;
      if (links.contains(document.activeElement)) brand.focus({ preventScroll: true });
      sync();
    };

    // Draw the right state before transitions switch on, so a load or restore mid-page doesn't animate
    const settle = () => {
      nav.classList.remove("is-ready");
      previousY = readScroll();
      distance = 0;
      wide = readWide();
      isTop = atTop(previousY);
      hidden = hovered = pinned = false;
      sync();
      requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.add("is-ready")));
    };

    // Hover opens the pill only when the mouse really moves onto it. When the pill scrolls back in under a
    // resting mouse, the browser still reports the pointer entering and moving, at the same spot on screen;
    // that must not open it, since scrolling never opens the nav
    let pointerX = NaN;
    let pointerY = NaN;
    document.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const moved = event.clientX !== pointerX || event.clientY !== pointerY;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!moved || hovered || hoverBlocked || !nav.contains(event.target as Node)) return;
      hovered = true;
      sync();
    });
    nav.addEventListener("pointerleave", () => {
      hovered = hoverBlocked = false;
      sync();
    });
    nav.addEventListener("focusout", (event) => {
      if (nav.contains(event.relatedTarget as Node | null)) return;
      requestAnimationFrame(() => {
        if (nav.contains(document.activeElement)) return;
        pinned = false;
        sync();
      });
    });
    brand.addEventListener("click", () => {
      if (isTop && wide) return; // the bar is already open
      if (pinned) close();
      else {
        pinned = true;
        sync();
      }
    });
    // Picking a link closes the menu (a Home section link then scrolls to its section)
    links.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) close();
    });
    document.addEventListener("click", (event) => {
      if (!nav.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) close();
    });
    window.addEventListener(
      "scroll",
      () => {
        const y = readScroll();
        const delta = y - previousY;
        previousY = y;
        if (!delta) return;
        isTop = atTop(y);
        if (isTop) hidden = false;
        distance = Math.sign(delta) === Math.sign(distance) ? distance + delta : delta;
        if (Math.abs(distance) >= scrollThreshold) {
          pinned = false;
          hidden = distance > 0 && !isTop;
          if (hidden) hovered = false;
          distance = 0;
        }
        sync();
      },
      { passive: true },
    );
    window.addEventListener("resize", () => {
      wide = readWide();
      sync();
    });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) settle();
    });
    settle();
  }
</script>

<style is:global>
  @layer components {
    /* .site-header and .site-nav keep their old names: the page scripts read them */
    .site-header {
      --site-nav-logo-width: calc(8.875rem * 1.19);
      --site-nav-compact: calc(var(--site-nav-logo-width) + 2.625rem);
      --site-nav-bar: calc(var(--site-nav-logo-width) * 202 / 960 + 2.125rem);
      position: absolute;
      inset: 0 0 auto;
      z-index: 5;
      height: var(--nav-height);
      pointer-events: none;
    }
    .site-header_position {
      position: fixed;
      z-index: 20;
      inset: max(0.875rem, env(safe-area-inset-top)) 0 auto;
      display: flex;
      justify-content: center;
      container-type: inline-size;
    }

    /* ---------- The pill ---------- */
    .site-nav {
      --site-nav-time: 0.44s;
      --site-nav-reveal: 0.22;
      --site-nav-transition: var(--site-nav-time) cubic-bezier(0.22, 1, 0.36, 1);
      --site-nav-wide: min(56.25rem, calc(100cqw - 1.5rem));
      /* Read by the script: whether the full bar fits */
      --site-nav-mode: wide;
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      width: min(var(--site-nav-compact), calc(100% - 1.5rem));
      height: var(--site-nav-bar);
      overflow: clip;
      border: 0.0625rem solid var(--border);
      border-radius: calc(var(--site-nav-bar) / 2);
      background: rgb(255 255 255 / 80%);
      -webkit-backdrop-filter: blur(0.3125rem);
      backdrop-filter: blur(0.3125rem);
      box-shadow: 0 0.0625rem 0.25rem rgb(31 31 35 / 8%);
      color: var(--heading);
      pointer-events: auto;
      /* No transitions until the first state is drawn, so a load or restore mid-page doesn't animate */
      &.is-ready {
        transition:
          width var(--site-nav-transition),
          height var(--site-nav-transition),
          translate var(--site-nav-transition),
          opacity var(--site-nav-transition);
        @media (prefers-reduced-motion: reduce) {
          transition: none;
        }
      }
      &.is-open {
        width: var(--site-nav-wide);
      }
      /* At the top of the page the full bar is open, where it fits */
      @container not (max-width: 56.25rem) {
        &.is-top {
          width: var(--site-nav-wide);
        }
      }
      &.is-scroll-hidden:not(:has(:focus-visible)) {
        translate: 0 calc(-100% - max(0.875rem, env(safe-area-inset-top)) - 0.25rem);
        opacity: 0;
        pointer-events: none;
      }
      & a {
        display: grid;
        place-items: center;
        min-height: 2.75rem;
        padding: 0 0.5625rem;
        border-radius: 999px;
        color: inherit;
        font-size: 0.875rem;
        font-weight: var(--primary-medium);
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        &[hidden] {
          display: none;
        }
        &:hover,
        &[aria-current="page"] {
          background: var(--background-2);
        }
      }
      & :focus-visible {
        outline: 0.125rem solid currentColor;
        outline-offset: -0.1875rem;
      }
      /* The pill's own width, not the screen's: the open menu stacks into two columns */
      @container (max-width: 56.25rem) {
        --site-nav-wide: min(26.25rem, calc(100cqw - 1.5rem));
        --site-nav-mode: narrow;
        max-height: calc(100dvh - max(0.875rem, env(safe-area-inset-top)) - 0.75rem);
        &.is-open {
          height: calc(var(--site-nav-bar) + 11.9375rem);
        }
        & a {
          white-space: normal;
          text-align: center;
        }
      }
    }
    .site-nav_brand {
      position: relative;
      z-index: 1;
      flex: none;
      display: grid;
      place-items: center;
      width: min(11rem, calc(100% - 0.5rem));
      height: calc(var(--site-nav-bar) - 0.5rem);
      margin-top: 0.1875rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      color: inherit;
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      &:active {
        background: var(--background-2);
      }
      & img {
        display: block;
        width: var(--site-nav-logo-width);
        height: auto;
        filter: brightness(0) invert(12%);
      }
    }
    .site-nav_links {
      position: absolute;
      inset: 0 auto 0 50%;
      translate: -50% 0;
      width: calc(var(--site-nav-wide) - 0.125rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11.5rem minmax(0, 1fr);
      align-items: center;
      opacity: 0;
      .site-nav.is-ready & {
        transition: opacity calc(var(--site-nav-time) * 0.22) ease;
        @media (prefers-reduced-motion: reduce) {
          transition: none;
        }
      }
      .site-nav.is-open & {
        opacity: 1;
        transition-delay: calc(var(--site-nav-time) * var(--site-nav-reveal));
      }
      @container not (max-width: 56.25rem) {
        .site-nav.is-top & {
          opacity: 1;
          transition-delay: calc(var(--site-nav-time) * var(--site-nav-reveal));
        }
      }
      @container (max-width: 56.25rem) {
        inset: var(--site-nav-bar) 0.625rem 0.5rem;
        translate: none;
        width: auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-content: start;
        gap: 0.25rem;
      }
    }
    .site-nav_side {
      display: flex;
      align-items: center;
      justify-content: center;
      &:last-child {
        grid-column: -2;
      }
      @container (max-width: 56.25rem) {
        flex-direction: column;
        align-items: stretch;
      }
    }
    .site-nav .site-nav_cta {
      padding-inline: 0.875rem;
      color: #fff;
      background: var(--c-disciples);
      &:hover {
        background: color-mix(in srgb, var(--c-disciples), black 21%);
      }
    }
  }
</style>
