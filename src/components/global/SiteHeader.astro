---
import type { HTMLAttributes } from "astro/types";
import { showLeadership } from "@/utils/leadership.ts";

interface Props extends HTMLAttributes<"header"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The page the header sits on. Home links to its own sections; other pages link back to them. */
  page: "home" | "groups" | "leadership" | "videos" | "embed" | "other";
}

const { render = true, page, class: className, ...rest } = Astro.props;

const onHome = page === "home";
const home = onHome ? "" : "/";
const left = [
  { label: "Home", href: onHome ? "#top" : "/", current: onHome },
  { label: "What we do", href: `${home}#what-we-do` },
  { label: "How we do it", href: `${home}#how` },
  { label: "Our story", href: `${home}#story` },
];
const right = [
  { label: "Groups", href: "/groups", current: page === "groups" },
  { label: "Leadership", href: "/leadership", current: page === "leadership", render: showLeadership() },
  { label: "Videos", href: "/videos", current: page === "videos" },
  { label: "App", href: `${home}#app` },
].filter((link) => link.render !== false);
// Phones: one list, the pages first and Home's sections under a rule (no Find a hub)
const phonePages = [left[0], ...right.filter((link) => link.label !== "App")];
const phoneSections = [...left.slice(1), ...right.filter((link) => link.label === "App")];
---

{
  render && page !== "embed" && (
    <header class:list={["site-header", className]} {...rest}>
      <div class="site-header_position">
        {/* Phones: tapping outside the open menu closes it */}
        <div class="site-menu_dim" inert />
        <nav class="site-nav is-top" aria-label="Site navigation">
          <a class="site-nav_home" href={onHome ? "#top" : "/"} aria-label="The Rock Network home">
            <img src="/assets/the-rock-network.png" alt="" width="960" height="202" />
          </a>
          <button class="site-nav_toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
            <span aria-hidden="true" />
          </button>
          <button
            class="site-nav_brand"
            type="button"
            aria-label="The Rock Network menu"
            aria-expanded="false"
            aria-controls="site-nav-links"
          >
            <img src="/assets/the-rock-network.png" alt="" width="960" height="202" />
          </button>
          <div class="site-nav_links" id="site-nav-links" aria-hidden="true" inert>
            <div class="site-nav_side">
              {left.map((link) => (
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
            <div class="site-nav_side">
              {right.map((link) => (
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              ))}
              {onHome && (
                <a class="site-nav_cta" href="#hubs" hidden>
                  Find a hub
                </a>
              )}
            </div>
          </div>
        </nav>
        <nav class="site-menu" id="site-menu" aria-label="Menu" inert>
          <ul class="site-menu_list">
            {phonePages.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <hr class="site-menu_rule" />
          <ul class="site-menu_list">
            {phoneSections.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
  )
}

<script>
  // Option B (docs/superpowers/specs/2026-11-19-floating-nav-behavior-design.md): at the top of a wide screen the
  // bar is open; while reading it's a pill that hides on the way down and returns, closed, on the way up. Only
  // hover, a click or tap, or keyboard focus open the pill. Scrolling never does.
  const nav = document.querySelector<HTMLElement>(".site-nav");
  const brand = nav?.querySelector<HTMLButtonElement>(".site-nav_brand");
  const links = nav?.querySelector<HTMLElement>(".site-nav_links");
  const header = nav?.closest<HTMLElement>(".site-header");
  const toggle = nav?.querySelector<HTMLButtonElement>(".site-nav_toggle");
  const menu = header?.querySelector<HTMLElement>(".site-menu");
  const dim = header?.querySelector<HTMLElement>(".site-menu_dim");
  if (nav && brand && links && header && toggle && menu && dim) {
    const scrollThreshold = 18;
    const readScroll = () => {
      const limit = document.documentElement.scrollHeight - window.innerHeight;
      return Math.max(0, Math.min(window.scrollY, limit));
    };
    // Within 5rem of the top counts as the top
    const atTop = (y: number) => y < 5 * parseFloat(getComputedStyle(document.documentElement).fontSize);
    // The pill's container query says whether the full bar fits (see --site-nav-mode below)
    const readWide = () => getComputedStyle(nav).getPropertyValue("--site-nav-mode").trim() !== "narrow";

    let previousY = readScroll();
    let distance = 0;
    let wide = readWide();
    let isTop = atTop(previousY);
    let hidden = false;
    let hovered = false;
    let pinned = false;
    // After closing it under the mouse (logo, Escape or a link), hover waits until the mouse leaves
    let hoverBlocked = false;

    // Phones (narrow): the ☰ button opens a menu card on the right instead; the pill itself never opens
    let menuOpen = false;
    const setMenu = (open: boolean, returnFocus = false) => {
      if (open === menuOpen) return;
      menuOpen = open;
      header.classList.toggle("is-menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      menu.inert = dim.inert = !open;
      if (!open && returnFocus) toggle.focus({ preventScroll: true });
    };

    const sync = () => {
      const asked = wide && (pinned || hovered || Boolean(links.querySelector(":focus-visible")));
      const open = asked || (isTop && wide);
      if (!open && links.contains(document.activeElement)) brand.focus({ preventScroll: true });
      nav.classList.toggle("is-top", isTop);
      nav.classList.toggle("is-open", asked);
      nav.classList.toggle("is-scroll-hidden", hidden);
      brand.setAttribute("aria-expanded", String(open));
      links.inert = !open;
      links.setAttribute("aria-hidden", String(!open));
    };

    const close = () => {
      pinned = hovered = false;
      if (nav.matches(":hover")) hoverBlocked = true;
      if (links.contains(document.activeElement)) brand.focus({ preventScroll: true });
      sync();
    };

    // Draw the right state before transitions switch on, so a load or restore mid-page doesn't animate
    const settle = () => {
      nav.classList.remove("is-ready");
      previousY = readScroll();
      distance = 0;
      wide = readWide();
      isTop = atTop(previousY);
      hidden = hovered = pinned = false;
      setMenu(false);
      sync();
      requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.add("is-ready")));
    };

    // Hover opens the pill only when the mouse really moves onto it. When the pill scrolls back in under a
    // resting mouse, the browser still reports the pointer entering and moving, at the same spot on screen;
    // that must not open it, since scrolling never opens the nav
    let pointerX = NaN;
    let pointerY = NaN;
    document.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const moved = event.clientX !== pointerX || event.clientY !== pointerY;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!moved || hovered || hoverBlocked || !nav.contains(event.target as Node)) return;
      hovered = true;
      sync();
    });
    nav.addEventListener("pointerleave", () => {
      hovered = hoverBlocked = false;
      sync();
    });
    nav.addEventListener("focusout", (event) => {
      if (nav.contains(event.relatedTarget as Node | null)) return;
      requestAnimationFrame(() => {
        if (nav.contains(document.activeElement)) return;
        pinned = false;
        sync();
      });
    });
    brand.addEventListener("click", () => {
      if (isTop && wide) return; // the bar is already open
      if (pinned) close();
      else {
        pinned = true;
        sync();
      }
    });
    toggle.addEventListener("click", () => setMenu(!menuOpen, true));
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setMenu(false);
    });
    // Picking a link closes the menu (a Home section link then scrolls to its section)
    links.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) close();
    });
    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!nav.contains(target)) close();
      if (menuOpen && !menu.contains(target) && !toggle.contains(target)) setMenu(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (menuOpen) setMenu(false, true);
      else if (nav.classList.contains("is-open")) close();
    });
    window.addEventListener(
      "scroll",
      () => {
        const y = readScroll();
        const delta = y - previousY;
        previousY = y;
        if (!delta) return;
        isTop = atTop(y);
        if (isTop) hidden = false;
        distance = Math.sign(delta) === Math.sign(distance) ? distance + delta : delta;
        if (Math.abs(distance) >= scrollThreshold) {
          pinned = false;
          setMenu(false);
          hidden = distance > 0 && !isTop;
          if (hidden) hovered = false;
          distance = 0;
        }
        sync();
      },
      { passive: true },
    );
    window.addEventListener("resize", () => {
      wide = readWide();
      if (wide) setMenu(false);
      sync();
    });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) settle();
    });
    settle();
  }
</script>

<style is:global>
  @layer components {
    /* .site-header and .site-nav keep their old names: the page scripts read them */
    .site-header {
      --site-nav-logo-width: calc(8.875rem * 1.19);
      --site-nav-compact: calc(var(--site-nav-logo-width) + 2.625rem);
      --site-nav-bar: calc(var(--site-nav-logo-width) * 202 / 960 + 2.125rem);
      position: absolute;
      inset: 0 0 auto;
      z-index: 5;
      height: var(--nav-height);
      pointer-events: none;
    }
    .site-header_position {
      position: fixed;
      z-index: 20;
      inset: max(0.875rem, env(safe-area-inset-top)) 0 auto;
      display: flex;
      justify-content: center;
      container-type: inline-size;
    }

    /* ---------- The pill ---------- */
    .site-nav {
      --site-nav-time: 0.44s;
      --site-nav-reveal: 0.22;
      --site-nav-transition: var(--site-nav-time) cubic-bezier(0.22, 1, 0.36, 1);
      --site-nav-wide: min(56.25rem, calc(100cqw - 1.5rem));
      /* Read by the script: whether the full bar fits */
      --site-nav-mode: wide;
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      width: min(var(--site-nav-compact), calc(100% - 1.5rem));
      height: var(--site-nav-bar);
      overflow: clip;
      border: 0.0625rem solid var(--border);
      border-radius: calc(var(--site-nav-bar) / 2);
      background: rgb(255 255 255 / 80%);
      -webkit-backdrop-filter: blur(0.3125rem);
      backdrop-filter: blur(0.3125rem);
      box-shadow: 0 0.0625rem 0.25rem rgb(31 31 35 / 8%);
      color: var(--heading);
      pointer-events: auto;
      /* No transitions until the first state is drawn, so a load or restore mid-page doesn't animate */
      &.is-ready {
        transition:
          width var(--site-nav-transition),
          height var(--site-nav-transition),
          translate var(--site-nav-transition),
          opacity var(--site-nav-transition);
        @media (prefers-reduced-motion: reduce) {
          transition: none;
        }
      }
      &.is-open {
        width: var(--site-nav-wide);
      }
      /* At the top of the page the full bar is open, where it fits */
      @container not (max-width: 56.25rem) {
        &.is-top {
          width: var(--site-nav-wide);
        }
      }
      &.is-scroll-hidden:not(:has(:focus-visible)) {
        translate: 0 calc(-100% - max(0.875rem, env(safe-area-inset-top)) - 0.25rem);
        opacity: 0;
        pointer-events: none;
      }
      & a {
        display: grid;
        place-items: center;
        min-height: 2.75rem;
        padding: 0 0.5625rem;
        border-radius: 999px;
        color: inherit;
        font-size: 0.875rem;
        font-weight: var(--primary-medium);
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        &[hidden] {
          display: none;
        }
        &:hover,
        &[aria-current="page"] {
          background: var(--background-2);
        }
      }
      & :focus-visible {
        outline: 0.125rem solid currentColor;
        outline-offset: -0.1875rem;
      }
      /* Phones and narrow windows (the pill's own width, not the screen's): a full-width bar with the logo on the
         left and the Menu button on the right; the menu opens as a card below it (.site-menu) */
      @container (max-width: 56.25rem) {
        --site-nav-mode: narrow;
        width: calc(100cqw - 1.5rem);
        align-items: center;
        justify-content: space-between;
        padding-inline: 1.125rem 0.375rem;
      }
    }
    .site-nav_home,
    .site-nav_toggle {
      display: none;
      @container (max-width: 56.25rem) {
        display: grid;
      }
    }
    .site-nav .site-nav_home {
      display: none;
      place-items: center;
      min-height: 2.75rem;
      padding: 0;
      background: none;
      & img {
        display: block;
        width: calc(var(--site-nav-logo-width) * 0.86);
        height: auto;
        filter: brightness(0) invert(12%);
      }
      @container (max-width: 56.25rem) {
        display: grid;
      }
    }
    /* Three bars that turn into an X while the menu is open */
    .site-nav_toggle {
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--heading);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      &:active {
        background: var(--background-2);
      }
      & span,
      & span::before,
      & span::after {
        display: block;
        width: 1.25rem;
        height: 0.125rem;
        border-radius: 0.0625rem;
        background: currentColor;
        transition:
          transform 0.22s ease,
          opacity 0.22s ease;
      }
      & span {
        position: relative;
      }
      & span::before,
      & span::after {
        content: "";
        position: absolute;
        left: 0;
      }
      & span::before {
        top: -0.375rem;
      }
      & span::after {
        top: 0.375rem;
      }
      &[aria-expanded="true"] span {
        background: transparent;
      }
      &[aria-expanded="true"] span::before {
        transform: translateY(0.375rem) rotate(45deg);
      }
      &[aria-expanded="true"] span::after {
        transform: translateY(-0.375rem) rotate(-45deg);
      }
      @media (prefers-reduced-motion: reduce) {
        & span,
        & span::before,
        & span::after {
          transition: none;
        }
      }
    }
    /* The phone menu: one list in a card that grows out of the Menu button's corner */
    .site-menu {
      display: none;
      position: absolute;
      top: calc(var(--site-nav-bar) + 0.5rem);
      right: 0.75rem;
      width: clamp(13rem, 66cqw, 20rem);
      max-height: calc(100dvh - var(--site-nav-bar) - 2.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.375rem;
      border: 0.0625rem solid var(--border);
      border-radius: 1.25rem;
      background: rgb(255 255 255 / 94%);
      -webkit-backdrop-filter: blur(0.75rem);
      backdrop-filter: blur(0.75rem);
      box-shadow: 0 1.25rem 2.5rem -1rem rgb(31 31 35 / 30%);
      transform-origin: top right;
      opacity: 0;
      scale: 0.94;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.18s ease,
        scale 0.18s ease,
        visibility 0s linear 0.18s;
      .site-header.is-menu-open & {
        opacity: 1;
        scale: 1;
        visibility: visible;
        pointer-events: auto;
        transition:
          opacity 0.18s ease,
          scale 0.18s cubic-bezier(0.2, 0.8, 0.2, 1),
          visibility 0s;
      }
      @media (prefers-reduced-motion: reduce) {
        transition: none;
        .site-header.is-menu-open & {
          transition: none;
        }
      }
      @container (max-width: 56.25rem) {
        display: block;
      }
    }
    .site-menu_list {
      margin: 0;
      padding: 0;
      list-style: none;
      & a {
        display: flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 1rem;
        border-radius: 0.875rem;
        color: var(--heading);
        font-size: 1rem;
        font-weight: var(--primary-medium);
        text-decoration: none;
        &:hover,
        &[aria-current="page"] {
          background: var(--background-2);
        }
        &:focus-visible {
          outline: 0.125rem solid currentColor;
          outline-offset: -0.1875rem;
        }
      }
    }
    .site-menu_rule {
      margin: 0.375rem 1rem;
      border: 0;
      border-top: 0.0625rem solid var(--border);
    }
    .site-menu_dim {
      position: fixed;
      inset: 0;
      background: rgb(4 16 28 / 22%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.18s ease,
        visibility 0s linear 0.18s;
      .site-header.is-menu-open & {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition: opacity 0.18s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        transition: none;
        .site-header.is-menu-open & {
          transition: none;
        }
      }
    }
    .site-nav_brand {
      position: relative;
      z-index: 1;
      flex: none;
      display: grid;
      place-items: center;
      width: min(11rem, calc(100% - 0.5rem));
      height: calc(var(--site-nav-bar) - 0.5rem);
      margin-top: 0.1875rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      color: inherit;
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      &:active {
        background: var(--background-2);
      }
      & img {
        display: block;
        width: var(--site-nav-logo-width);
        height: auto;
        filter: brightness(0) invert(12%);
      }
      @container (max-width: 56.25rem) {
        display: none;
      }
    }
    .site-nav_links {
      position: absolute;
      inset: 0 auto 0 50%;
      translate: -50% 0;
      width: calc(var(--site-nav-wide) - 0.125rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11.5rem minmax(0, 1fr);
      align-items: center;
      opacity: 0;
      .site-nav.is-ready & {
        transition: opacity calc(var(--site-nav-time) * 0.22) ease;
        @media (prefers-reduced-motion: reduce) {
          transition: none;
        }
      }
      .site-nav.is-open & {
        opacity: 1;
        transition-delay: calc(var(--site-nav-time) * var(--site-nav-reveal));
      }
      @container not (max-width: 56.25rem) {
        .site-nav.is-top & {
          opacity: 1;
          transition-delay: calc(var(--site-nav-time) * var(--site-nav-reveal));
        }
      }
      @container (max-width: 56.25rem) {
        display: none;
      }
    }
    .site-nav_side {
      display: flex;
      align-items: center;
      justify-content: center;
      &:last-child {
        grid-column: -2;
      }
    }
    .site-nav .site-nav_cta {
      padding-inline: 0.875rem;
      color: #fff;
      background: var(--c-disciples);
      &:hover {
        background: color-mix(in srgb, var(--c-disciples), black 21%);
      }
    }
  }
</style>
