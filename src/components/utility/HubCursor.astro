---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <Fragment>
      {/* Hub cursor: a circle with an arrow follows the pointer over a hub (or a How we do it point), with its
          photo pin above it (or, in the Photo style, the photo itself follows the pointer). Driven by
          public/scripts/home-hubs.js. */}
      <div class="hub-cursor" id="hub-cursor" aria-hidden="true">
        <div class="photo"><img alt=""><img alt=""></div>
        <div class="ball">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </div>
      </div>
    </Fragment>
  )
}

<style is:global>
  @layer components {
    /* The hub cursor and its photo pin (pointer devices only) */
    .has-hub-cursor .hub-row, .has-hub-cursor .hub-row * { cursor: none; }
    .hub-cursor { position: fixed; left: 0; top: 0; z-index: 8; pointer-events: none; }
    .hub-cursor .ball { position: absolute; left: 0; top: 0; width: 4.75rem; height: 4.75rem; margin: -2.375rem 0 0 -2.375rem; border-radius: 50%; background: var(--hc, var(--heading)); display: grid; place-items: center; transform: scale(var(--s, 0)); transition: transform .45s cubic-bezier(.65, 0, .35, 1), background .45s ease; }
    .hub-cursor .ball svg { width: 1.625rem; height: 1.625rem; }
    .hub-cursor .pin { position: absolute; left: 0; top: 0; width: 15rem; height: calc(15rem * 1080 / 1168); opacity: var(--p, 0); transform-origin: calc(15rem * 0.4846) 100%; transform: translate(calc(15rem * -0.4846 + var(--dx, 0rem)), calc(-100% - 2.875rem)) translateY(calc((1 - var(--p, 0)) * 0.75rem)) scale(calc(0.6 + 0.4 * var(--p, 0))); transition: opacity .45s ease, transform .5s cubic-bezier(.65, 0, .35, 1); }
    .hub-cursor .pin-photo { transition: opacity .35s ease; }
    /* Hub cursor styles (Adjust panel, Page: Hub cursor). White circle (the default): a white circle with the arrow
     in the hub's color, so it stands out on the filled row. Ringed circle: the hub-colored circle with a white
     ring. Photo: the cursor becomes the hub's photo in a tall rounded rectangle, with no circle or pin. */
    .hub-cursor .ball { background: #fff; box-shadow: 0 0.375rem 1.125rem rgba(0, 0, 0, .16); }
    .hub-cursor .ball svg { stroke: var(--hc, var(--heading)); transition: stroke .45s ease; }
    html[data-hub-cursor="ring"] .hub-cursor .ball { background: var(--hc, var(--heading)); box-shadow: 0 0 0 0.1875rem #fff, 0 0.375rem 1.125rem rgba(0, 0, 0, .18); }
    html[data-hub-cursor="ring"] .hub-cursor .ball svg { stroke: #fff; }
    .hub-cursor .photo { position: absolute; left: 0; top: 0; width: 9.375rem; height: 12.5rem; margin: -6.25rem 0 0 -4.6875rem; border-radius: 1.5rem; overflow: hidden; display: none; box-shadow: 0 1.125rem 2.5rem rgba(0, 0, 0, .22); transform: scale(var(--p, 0)); transition: transform .5s cubic-bezier(.65, 0, .35, 1); }
    .hub-cursor .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(calc(1.25 - .25 * var(--p, 0))); transition: opacity .3s ease, transform .7s cubic-bezier(.22, 1, .36, 1); }
    html[data-hub-cursor="photo"] .hub-cursor .photo { display: block; }
    html[data-hub-cursor="photo"] .hub-cursor :is(.ball, .pin) { display: none; }
    @media (max-width: 47.4375em) {
      .hub-dots { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hub-cursor .ball, .hub-cursor .pin, .hub-cursor .photo, .hub-cursor .photo img, .hub-row, .hub-row::before, .hub-dots i { transition: none !important; }
    }
  }
</style>
